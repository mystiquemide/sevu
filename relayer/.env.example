# Relayer wallet. Holds POL for gas only, never user funds.
RELAYER_PRIVATE_KEY=
# Comma-separated, primary first. Example: Alchemy, then publicnode.
POLYGON_RPC_URLS=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY,https://polygon-bor-rpc.publicnode.com
SEVU_LOCK_ADDRESS=
# Earlier SevuLock deployments, comma-separated. Withdrawals only.
SEVU_LEGACY_LOCK_ADDRESSES=
USDT0_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
# Base units (6 decimals). 10 USDT.
MAX_LOCK_AMOUNT=10000000
# Daily POL budget for gas, in wei. 5 POL.
DAILY_GAS_BUDGET_WEI=5000000000000000000
# Below this relayer balance /v1/health reports "low". 1 POL.
LOW_BALANCE_WEI=1000000000000000000
# Comma-separated origins allowed by CORS.
ALLOWED_ORIGINS=https://sevu.vercel.app
PORT=8787
